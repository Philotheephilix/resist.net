{
  "name": "resist.net",
  "private": true,
  "packageManager": "npm@11.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "playwright test",
    "test:arkiv": "tsx scripts/test-arkiv-live.ts",
    "typecheck": "tsc -p packages/arkiv-sdk/tsconfig.json --noEmit && tsc -p packages/probe-node/tsconfig.json --noEmit && tsc -p packages/proxy-client/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/ngeohash": "^0.6.8",
    "@types/topojson-client": "^3.1.5",
    "node-datachannel": "^0.33.4",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@privy-io/react-auth": "^3.49.0",
    "@stripe/stripe-js": "^10.1.0",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "react-globe.gl": "^2.38.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "allowScripts": {
    "node-datachannel@0.33.4": true
  }
}
